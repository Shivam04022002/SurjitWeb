NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/surjitfinance_cms

JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://surjitfinance.com

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=surjit-finance-cms-uploads
AWS_S3_BASE_URL=https://surjit-finance-cms-uploads.s3.ap-south-1.amazonaws.com

BCRYPT_SALT_ROUNDS=12

# Rate limiting (all optional — sensible defaults apply)
# General API limit, per IP:
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
# Login limit, per IP + email, FAILED attempts only (resets on success):
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Gemini blog generation (all optional)
# The API key is normally entered by a Super Admin in the CMS (API page) and
# stored encrypted. Setting GEMINI_API_KEY here overrides it. Never commit a key.
# GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TIMEOUT_MS=55000
# Optional. Base delay (ms) before retrying a Gemini 500/503 response: about
# this long before the first retry, twice that before the second. Retries
# stay within GEMINI_TIMEOUT_MS.
GEMINI_RETRY_BASE_MS=1000
# Optional. FREE text models to fall back to, in order, when the API-page
# model is out of quota (429) or still overloaded after retries (500/503).
# Comma separated; empty means no fallback. Image/audio/video models are
# ignored here. List only models your account can use for free, for example
# gemini-3.5-flash,gemini-flash-lite-latest. Normally set on the CMS API page
# instead; this is used only while no list is saved there.
GEMINI_FALLBACK_TEXT_MODELS=
# Optional. How long (ms) a model is skipped after a quota error without a
# Google retry delay, and after an overload that retries could not fix.
GEMINI_QUOTA_COOLDOWN_MS=60000
GEMINI_OVERLOAD_COOLDOWN_MS=30000

# Free featured images from Pexels (https://www.pexels.com/api/). Optional:
# the key is normally saved by a Super Admin on the CMS API page (stored
# encrypted), and this is used only while no key is saved there. With
# neither, admins upload featured images themselves. Never commit a key.
PEXELS_API_KEY=
# Per-admin limit on Gemini calls (generate, image, test):
# GEMINI_RATE_LIMIT_WINDOW_MS=3600000
# GEMINI_RATE_LIMIT_MAX=40
# Encrypts stored integration keys. Recommended: a long random value. If unset,
# a key derived from JWT_ACCESS_SECRET is used, and rotating that secret means
# stored integration keys must be re-entered.
# SETTINGS_ENCRYPTION_KEY=

SUPER_ADMIN_EMAIL=admin@surjitfinance.com
SUPER_ADMIN_PASSWORD=Admin@123
